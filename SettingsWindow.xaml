<Window x:Class="DellWarrantyScanner.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="520" Height="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="90" Height="34"
                    Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Save" Width="90" Height="34"
                    IsDefault="True" Click="Save_Click"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="{DynamicResource AccentForeground}"
                    BorderThickness="0"/>
        </StackPanel>

        <GroupBox Header="Configuration" Padding="8"
                  Foreground="{DynamicResource TextPrimary}">
            <StackPanel>
                <TextBlock Text="— Dell TechDirect API —" FontWeight="SemiBold"
                           Margin="0,4,0,8" Foreground="{DynamicResource TextPrimary}"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Client ID:"
                           Foreground="{DynamicResource TextPrimary}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="_txtClientId"
                             Margin="0,2,0,4"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Client Secret:"
                           Foreground="{DynamicResource TextPrimary}"/>
                    <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="_txtClientSecret"
                                 Margin="0,2,0,4"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                               Margin="0,2,0,8" FontSize="11">
                        <Hyperlink NavigateUri="https://tdm.dell.com"
                                   RequestNavigate="Hyperlink_RequestNavigate">
                            Get credentials at Dell TechDirect → API Management
                        </Hyperlink>
                    </TextBlock>
                </Grid>

                <TextBlock Text="— WMI Credentials —" FontWeight="SemiBold"
                           Margin="0,4,0,8" Foreground="{DynamicResource TextPrimary}"/>

                <RadioButton x:Name="_rbCurrentUser"
                             Content="Use current Windows credentials"
                             Margin="0,0,0,4"
                             Foreground="{DynamicResource TextPrimary}"/>
                <RadioButton x:Name="_rbSpecifiedUser"
                             Content="Use specified credentials"
                             Margin="0,0,0,8"
                             Foreground="{DynamicResource TextPrimary}"
                             Checked="SpecifiedUser_Checked"
                             Unchecked="SpecifiedUser_Unchecked"/>

                <Grid x:Name="_wmiCredPanel" IsEnabled="False" Margin="16,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Username:"
                           Foreground="{DynamicResource TextPrimary}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="_txtWmiUser"
                             Margin="0,2,0,4"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Password:"
                           Foreground="{DynamicResource TextPrimary}"/>
                    <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="_txtWmiPass"
                                 Margin="0,2,0,0"/>
                </Grid>
            </StackPanel>
        </GroupBox>
    </DockPanel>
</Window>
