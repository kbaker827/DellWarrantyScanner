<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="AppBackground"              Color="#F3F3F3"/>
    <SolidColorBrush x:Key="PanelBackground"            Color="#FFFFFF"/>
    <SolidColorBrush x:Key="StatusBarBackground"        Color="#F0F0F0"/>
    <SolidColorBrush x:Key="BorderBrush"                Color="#D0D0D0"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary"                Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TextSecondary"              Color="#666666"/>

    <!-- Accent buttons -->
    <SolidColorBrush x:Key="AccentBrush"                Color="#0067B8"/>
    <SolidColorBrush x:Key="AccentForeground"           Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DangerBrush"                Color="#C42B1C"/>
    <SolidColorBrush x:Key="DangerForeground"           Color="#FFFFFF"/>

    <!-- DataGrid -->
    <SolidColorBrush x:Key="GridHeaderBackground"       Color="#F0F0F0"/>
    <SolidColorBrush x:Key="GridRowBackground"          Color="#FFFFFF"/>
    <SolidColorBrush x:Key="GridRowAlternateBackground" Color="#FAFAFA"/>

    <!-- Row tints -->
    <SolidColorBrush x:Key="GridRowActiveBackground"         Color="#F0FFF0"/>
    <SolidColorBrush x:Key="GridRowActiveForeground"         Color="#2E7D32"/>
    <SolidColorBrush x:Key="GridRowExpiringSoonBackground"   Color="#FFFDE7"/>
    <SolidColorBrush x:Key="GridRowExpiringSoonForeground"   Color="#E65100"/>
    <SolidColorBrush x:Key="GridRowExpiredBackground"        Color="#FFF5F5"/>
    <SolidColorBrush x:Key="GridRowExpiredForeground"        Color="#C62828"/>

    <!-- Stat cards -->
    <SolidColorBrush x:Key="CardActiveBackground"       Color="#E8F5E9"/>
    <SolidColorBrush x:Key="CardActiveForeground"       Color="#2E7D32"/>
    <SolidColorBrush x:Key="CardExpiringSoonBackground" Color="#FFF8E1"/>
    <SolidColorBrush x:Key="CardExpiringSoonForeground" Color="#E65100"/>
    <SolidColorBrush x:Key="CardExpiredBackground"      Color="#FFEBEE"/>
    <SolidColorBrush x:Key="CardExpiredForeground"      Color="#C62828"/>

    <!-- DataGrid row styles (used by WarrantyRowStyleSelector) -->
    <Style x:Key="RowStyleDefault" TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource GridRowBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
    <Style x:Key="RowStyleActive" TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource GridRowActiveBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource GridRowActiveForeground}"/>
    </Style>
    <Style x:Key="RowStyleExpiringSoon" TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource GridRowExpiringSoonBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource GridRowExpiringSoonForeground}"/>
    </Style>
    <Style x:Key="RowStyleExpired" TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource GridRowExpiredBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource GridRowExpiredForeground}"/>
    </Style>
</ResourceDictionary>
