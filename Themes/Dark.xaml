<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="AppBackground"              Color="#1C1C1C"/>
    <SolidColorBrush x:Key="PanelBackground"            Color="#252525"/>
    <SolidColorBrush x:Key="StatusBarBackground"        Color="#0E0E0E"/>
    <SolidColorBrush x:Key="BorderBrush"                Color="#3A3A3A"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary"                Color="#E8E8E8"/>
    <SolidColorBrush x:Key="TextSecondary"              Color="#9A9A9A"/>

    <!-- Accent buttons -->
    <SolidColorBrush x:Key="AccentBrush"                Color="#0078D4"/>
    <SolidColorBrush x:Key="AccentForeground"           Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DangerBrush"                Color="#C42B1C"/>
    <SolidColorBrush x:Key="DangerForeground"           Color="#FFFFFF"/>

    <!-- DataGrid -->
    <SolidColorBrush x:Key="GridHeaderBackground"       Color="#2D2D2D"/>
    <SolidColorBrush x:Key="GridRowBackground"          Color="#1E1E1E"/>
    <SolidColorBrush x:Key="GridRowAlternateBackground" Color="#222222"/>

    <!-- Row tints -->
    <SolidColorBrush x:Key="GridRowActiveBackground"         Color="#1A3A1A"/>
    <SolidColorBrush x:Key="GridRowActiveForeground"         Color="#4CAF50"/>
    <SolidColorBrush x:Key="GridRowExpiringSoonBackground"   Color="#2A2A1A"/>
    <SolidColorBrush x:Key="GridRowExpiringSoonForeground"   Color="#FF9800"/>
    <SolidColorBrush x:Key="GridRowExpiredBackground"        Color="#3A1A1A"/>
    <SolidColorBrush x:Key="GridRowExpiredForeground"        Color="#F44336"/>

    <!-- Stat cards -->
    <SolidColorBrush x:Key="CardActiveBackground"       Color="#1A3A1A"/>
    <SolidColorBrush x:Key="CardActiveForeground"       Color="#4CAF50"/>
    <SolidColorBrush x:Key="CardExpiringSoonBackground" Color="#2A2A1A"/>
    <SolidColorBrush x:Key="CardExpiringSoonForeground" Color="#FF9800"/>
    <SolidColorBrush x:Key="CardExpiredBackground"      Color="#3A1A1A"/>
    <SolidColorBrush x:Key="CardExpiredForeground"      Color="#F44336"/>

    <!-- DataGrid row styles -->
    <Style x:Key="RowStyleDefault" TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource GridRowBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
    <Style x:Key="RowStyleActive" TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource GridRowActiveBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource GridRowActiveForeground}"/>
    </Style>
    <Style x:Key="RowStyleExpiringSoon" TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource GridRowExpiringSoonBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource GridRowExpiringSoonForeground}"/>
    </Style>
    <Style x:Key="RowStyleExpired" TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource GridRowExpiredBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource GridRowExpiredForeground}"/>
    </Style>
</ResourceDictionary>
