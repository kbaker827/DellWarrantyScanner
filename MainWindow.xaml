<Window x:Class="DellWarrantyScanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:DellWarrantyScanner.Converters"
        Title="Dell Warranty Scanner"
        Width="980" Height="680"
        MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/app.ico"
        Background="{DynamicResource AppBackground}"
        Loaded="Window_Loaded">

    <Window.Resources>
        <converters:WarrantyRowStyleSelector x:Key="WarrantyRowStyleSelector"/>
        <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource GridHeaderBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- Menu -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource PanelBackground}">
            <MenuItem Header="_File">
                <MenuItem x:Name="_menuExport" Header="Export to _CSV..."
                          IsEnabled="False" Click="ExportCsv"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem x:Name="_menuSettings" Header="_Settings..." Click="OpenSettings"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About Dell Warranty Scanner..." Click="ShowAbout"/>
                <Separator/>
                <MenuItem Header="Check for _Updates..." Click="CheckUpdates"/>
                <Separator/>
                <MenuItem Header="_Dell TechDirect API Setup..." Click="ShowHelp"/>
            </MenuItem>
        </Menu>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom"
                   Background="{DynamicResource StatusBarBackground}">
            <StatusBarItem>
                <TextBlock x:Name="_statusLabel"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="12"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,6,8,6">
            <StackPanel>
                <WrapPanel>
                    <Label Content="IP Range:" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,4,0"
                           Foreground="{DynamicResource TextPrimary}"/>
                    <TextBox x:Name="_txtIpRange" Width="230" Height="26"
                             Margin="0,0,6,0" VerticalContentAlignment="Center"
                             FontFamily="Consolas" FontSize="10"/>
                    <Button x:Name="_btnScan" Content="Scan Network"
                            Width="116" Height="30" Margin="0,0,4,0"
                            Click="StartScan"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource AccentForeground}"
                            BorderThickness="0"/>
                    <Button x:Name="_btnStopScan" Content="Stop Scan"
                            Width="90" Height="30" Margin="0,0,4,0"
                            IsEnabled="False" Click="StopScan_Click"
                            Background="{DynamicResource DangerBrush}"
                            Foreground="{DynamicResource DangerForeground}"
                            BorderThickness="0"/>
                    <Button Content="Auto-detect" Width="90" Height="30"
                            Margin="0,0,4,0" Click="AutoDetect_Click"/>
                    <Button Content="Export CSV" Width="96" Height="30"
                            Click="ExportCsv"/>
                </WrapPanel>
                <TextBlock Margin="82,4,0,0" FontSize="10"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="Formats: 192.168.1.0/24  |  10.0.0.1-50  |  10.0.0.1-10.0.0.50"/>
            </StackPanel>
        </Border>

        <!-- Stat cards -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource AppBackground}"
                Padding="8,6,8,6">
            <UniformGrid Columns="3" MaxWidth="380" HorizontalAlignment="Left">
                <Border Background="{DynamicResource CardActiveBackground}"
                        CornerRadius="6" Margin="0,0,8,0" Padding="12,8">
                    <StackPanel>
                        <TextBlock x:Name="_txtActiveCount" Text="0"
                                   FontSize="22" FontWeight="SemiBold"
                                   Foreground="{DynamicResource CardActiveForeground}"/>
                        <TextBlock Text="Active" FontSize="11"
                                   Foreground="{DynamicResource CardActiveForeground}"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardExpiringSoonBackground}"
                        CornerRadius="6" Margin="0,0,8,0" Padding="12,8">
                    <StackPanel>
                        <TextBlock x:Name="_txtExpiringSoonCount" Text="0"
                                   FontSize="22" FontWeight="SemiBold"
                                   Foreground="{DynamicResource CardExpiringSoonForeground}"/>
                        <TextBlock Text="Expiring Soon" FontSize="11"
                                   Foreground="{DynamicResource CardExpiringSoonForeground}"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardExpiredBackground}"
                        CornerRadius="6" Padding="12,8">
                    <StackPanel>
                        <TextBlock x:Name="_txtExpiredCount" Text="0"
                                   FontSize="22" FontWeight="SemiBold"
                                   Foreground="{DynamicResource CardExpiredForeground}"/>
                        <TextBlock Text="Expired" FontSize="11"
                                   Foreground="{DynamicResource CardExpiredForeground}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Border>

        <!-- Progress area -->
        <StackPanel DockPanel.Dock="Top" Margin="8,0,8,4">
            <TextBlock x:Name="_lblStatus" FontSize="11" Margin="0,0,0,2"
                       Foreground="{DynamicResource TextSecondary}"/>
            <ProgressBar x:Name="_progress" Height="6"
                         Minimum="0" Maximum="100" Value="0"/>
        </StackPanel>

        <!-- Tab control -->
        <TabControl x:Name="_tabs" Background="{DynamicResource AppBackground}">

            <!-- Network Scan tab -->
            <TabItem Header="  Network Scan Results  ">
                <DataGrid x:Name="_scanGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Extended"
                          RowStyleSelector="{StaticResource WarrantyRowStyleSelector}"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                          FontFamily="Segoe UI" FontSize="12"
                          Background="{DynamicResource GridRowBackground}"
                          RowBackground="{DynamicResource GridRowBackground}"
                          AlternatingRowBackground="{DynamicResource GridRowAlternateBackground}"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="IP Address"
                            Binding="{Binding IpAddress}"          Width="120" MinWidth="90"/>
                        <DataGridTextColumn Header="Hostname"
                            Binding="{Binding Hostname}"           Width="*"   MinWidth="140"/>
                        <DataGridTextColumn Header="Service Tag"
                            Binding="{Binding ServiceTag}"         Width="110" MinWidth="90"/>
                        <DataGridTextColumn Header="Model"
                            Binding="{Binding Model}"              Width="*"   MinWidth="140"/>
                        <DataGridTextColumn Header="Status"
                            Binding="{Binding WarrantyStatus}"     Width="90"  MinWidth="80"/>
                        <DataGridTextColumn Header="Warranty End"
                            Binding="{Binding WarrantyEndDisplay}" Width="110" MinWidth="90"/>
                        <DataGridTextColumn Header="Days Left"
                            Binding="{Binding DaysRemainingDisplay}" Width="80" MinWidth="70"/>
                        <DataGridTextColumn Header="Notes"
                            Binding="{Binding Notes}"              Width="*"   MinWidth="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Service Tag Lookup tab -->
            <TabItem Header="  Service Tag Lookup  ">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="10,8,10,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Service Tag(s):" FontWeight="SemiBold"
                                       Margin="0,0,0,4"
                                       Foreground="{DynamicResource TextPrimary}"/>

                            <TextBox Grid.Row="1" Grid.Column="0"
                                     x:Name="_txtServiceTags"
                                     Height="70" AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" FontSize="10"
                                     Margin="0,0,8,0"/>

                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <Button x:Name="_btnLookupTags"
                                        Content="Look Up Warranty"
                                        Width="148" Height="30" Margin="0,0,0,4"
                                        Click="StartTagLookup"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="{DynamicResource AccentForeground}"
                                        BorderThickness="0"/>
                                <Button Content="Import from CSV..."
                                        Width="148" Height="30" Margin="0,0,0,4"
                                        Click="ImportCsv_Click"/>
                                <Button x:Name="_btnStopLookup" Content="Stop"
                                        Width="148" Height="30" Margin="0,0,0,4"
                                        IsEnabled="False" Click="StopLookup_Click"
                                        Background="{DynamicResource DangerBrush}"
                                        Foreground="{DynamicResource DangerForeground}"
                                        BorderThickness="0"/>
                                <Button Content="Clear" Width="148" Height="30"
                                        Click="ClearTags_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock DockPanel.Dock="Top" Margin="10,3,0,3" FontSize="10"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="One tag per line, or comma/space/semicolon separated. Max 100 per lookup."/>

                    <DataGrid x:Name="_tagGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Extended"
                              RowStyleSelector="{StaticResource WarrantyRowStyleSelector}"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                              FontFamily="Segoe UI" FontSize="12"
                              Background="{DynamicResource GridRowBackground}"
                              RowBackground="{DynamicResource GridRowBackground}"
                              AlternatingRowBackground="{DynamicResource GridRowAlternateBackground}"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Service Tag"
                                Binding="{Binding ServiceTag}"         Width="110" MinWidth="90"/>
                            <DataGridTextColumn Header="Model"
                                Binding="{Binding Model}"              Width="*"   MinWidth="140"/>
                            <DataGridTextColumn Header="Status"
                                Binding="{Binding WarrantyStatus}"     Width="90"  MinWidth="80"/>
                            <DataGridTextColumn Header="Warranty End"
                                Binding="{Binding WarrantyEndDisplay}" Width="110" MinWidth="90"/>
                            <DataGridTextColumn Header="Days Left"
                                Binding="{Binding DaysRemainingDisplay}" Width="80" MinWidth="70"/>
                            <DataGridTextColumn Header="Notes"
                                Binding="{Binding Notes}"              Width="*"   MinWidth="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
